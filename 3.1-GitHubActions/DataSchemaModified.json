{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "StickTrainer AR: структура даних вправ, тренування та результатів",
    "type": "object",
    "description": "Обмінний знімок моделі даних StickTrainer AR, варіант 10",
    "properties": {
        "catalog": {
            "$ref": "#/$defs/catalog",
            "description": "Доступні вправи та еталони"
        },
        "currentTraining": {
            "description": "Поточне тренування в оперативній пам’яті; null за його відсутності",
            "anyOf": [
                {
                    "$ref": "#/$defs/training",
                    "description": "Активне тренування"
                },
                {
                    "type": "null"
                }
            ]
        },
        "results": {
            "type": "array",
            "description": "Локальна історія завершених тренувань",
            "items": {
                "$ref": "#/$defs/result",
                "description": "Результат"
            },
            "minItems": 0,
            "maxItems": 10000,
            "uniqueItems": true
        }
    },
    "required": [
        "catalog",
        "currentTraining",
        "results"
    ],
    "additionalProperties": false,
    "$defs": {
        "spatialState": {
            "type": "object",
            "description": "Просторовий стан опорної точки палиці у відкаліброваній системі відліку",
            "properties": {
                "xCm": {
                    "type": "number",
                    "description": "Координата x опорної точки, см"
                },
                "yCm": {
                    "type": "number",
                    "description": "Координата y опорної точки, см"
                },
                "zCm": {
                    "type": "number",
                    "description": "Координата z опорної точки, см"
                },
                "tiltDeg": {
                    "type": "number",
                    "description": "Нахил палиці, градуси",
                    "minimum": -180,
                    "maximum": 180
                },
                "yawDeg": {
                    "type": "number",
                    "description": "Поворот палиці, градуси",
                    "minimum": -180,
                    "maximum": 180
                },
                "rollDeg": {
                    "type": "number",
                    "description": "Обертання палиці, градуси",
                    "minimum": -180,
                    "maximum": 180
                }
            },
            "required": [
                "xCm",
                "yCm",
                "zCm",
                "tiltDeg",
                "yawDeg",
                "rollDeg"
            ],
            "additionalProperties": false
        },
        "phase": {
            "type": "object",
            "description": "Одна фаза еталона; порядок задається номером і позицією в масиві",
            "properties": {
                "number": {
                    "type": "integer",
                    "description": "Порядковий номер фази від 1",
                    "minimum": 1,
                    "maximum": 32
                },
                "name": {
                    "type": "string",
                    "description": "Назва фази",
                    "minLength": 3,
                    "maxLength": 60,
                    "pattern": "^[А-Яа-яІіЇїЄєҐґA-Za-z][А-Яа-яІіЇїЄєҐґA-Za-z0-9 '’()-]*$"
                },
                "referenceState": {
                    "$ref": "#/$defs/spatialState",
                    "description": "Еталонний просторовий стан фази"
                },
                "positionToleranceCm": {
                    "type": "number",
                    "description": "Допустиме відхилення положення, см",
                    "exclusiveMinimum": 0,
                    "maximum": 100
                },
                "angleToleranceDeg": {
                    "type": "number",
                    "description": "Допустима різниця кожного кута, градуси",
                    "exclusiveMinimum": 0,
                    "maximum": 180
                }
            },
            "required": [
                "number",
                "name",
                "referenceState",
                "positionToleranceCm",
                "angleToleranceDeg"
            ],
            "additionalProperties": false
        },
        "reference": {
            "type": "object",
            "description": "Еталон вправи: цільова кількість повторень та послідовність фаз",
            "properties": {
                "targetRepetitions": {
                    "type": "integer",
                    "description": "Цільова кількість повторень",
                    "minimum": 1,
                    "maximum": 100
                },
                "phases": {
                    "type": "array",
                    "description": "Фази у порядку виконання; остання завершує цикл",
                    "items": {
                        "$ref": "#/$defs/phase",
                        "description": "Опис фази"
                    },
                    "minItems": 1,
                    "maxItems": 32,
                    "uniqueItems": true
                }
            },
            "required": [
                "targetRepetitions",
                "phases"
            ],
            "additionalProperties": false
        },
        "exercise": {
            "type": "object",
            "description": "Вправа каталогу та її еталон",
            "properties": {
                "exerciseId": {
                    "type": "string",
                    "description": "Ідентифікатор вправи, також відомий з опису результату тренування",
                    "pattern": "^EX-[0-9]{3}$",
                    "minLength": 6,
                    "maxLength": 6
                },
                "name": {
                    "type": "integer",
                    "description": "Назва вправи",
                    "minLength": 3,
                    "maxLength": 100,
                    "pattern": "^[А-Яа-яІіЇїЄєҐґA-Za-z][А-Яа-яІіЇїЄєҐґA-Za-z0-9 '’()-]*$"
                },
                "reference": {
                    "$ref": "#/$defs/reference",
                    "description": "Еталон вправи"
                }
            },
            "required": [
                "exerciseId",
                "name",
                "reference"
            ],
            "additionalProperties": false
        },
        "catalog": {
            "type": "object",
            "description": "Каталог вправ, завантажуваний як JSON-ресурс",
            "properties": {
                "exercises": {
                    "type": "array",
                    "description": "Вправи; ідентифікатори унікальні в каталозі",
                    "items": {
                        "$ref": "#/$defs/exercise",
                        "description": "Опис вправи"
                    },
                    "minItems": 1,
                    "maxItems": 100,
                    "uniqueItems": true
                }
            },
            "required": [
                "exercises"
            ],
            "additionalProperties": false
        },
        "deviation": {
            "type": "object",
            "description": "Одне виявлене перевищення допуску фази",
            "properties": {
                "type": {
                    "description": "Вид відхилення",
                    "enum": [
                        "position",
                        "tilt",
                        "yaw",
                        "roll"
                    ]
                },
                "value": {
                    "type": "number",
                    "description": "Модуль відхилення: см для position, градуси для кутів",
                    "exclusiveMinimum": 0
                }
            },
            "required": [
                "type",
                "value"
            ],
            "additionalProperties": false,
            "if": {
                "properties": {
                    "type": {
                        "enum": [
                            "tilt",
                            "yaw",
                            "roll"
                        ]
                    }
                }
            },
            "then": {
                "properties": {
                    "value": {
                        "maximum": 180
                    }
                }
            }
        },
        "textCue": {
            "type": "object",
            "description": "Текстова підказка",
            "properties": {
                "channel": {
                    "description": "Спосіб надання; дискримінатор різновиду",
                    "const": "text"
                },
                "messageType": {
                    "description": "Корекція, втрата відстеження або підтвердження виправлення",
                    "enum": [
                        "correction",
                        "tracking_lost",
                        "correction_confirmed"
                    ]
                },
                "text": {
                    "type": "string",
                    "description": "Зміст короткого повідомлення українською мовою",
                    "minLength": 3,
                    "maxLength": 200,
                    "pattern": "^[^<>\\r\\n]+$",
                    "not": {
                        "pattern": "[<>\\r\\n]"
                    }
                }
            },
            "required": [
                "channel",
                "messageType",
                "text"
            ],
            "additionalProperties": false
        },
        "audioCue": {
            "type": "object",
            "description": "Звукова підказка; текст відповідає змісту аудіофрагмента",
            "properties": {
                "channel": {
                    "description": "Спосіб надання; дискримінатор різновиду",
                    "const": "audio"
                },
                "messageType": {
                    "description": "Корекція, втрата відстеження або підтвердження виправлення",
                    "enum": [
                        "correction",
                        "tracking_lost",
                        "correction_confirmed"
                    ]
                },
                "text": {
                    "type": "string",
                    "description": "Зміст короткого повідомлення українською мовою",
                    "minLength": 3,
                    "maxLength": 200,
                    "pattern": "^[^<>\\r\\n]+$",
                    "not": {
                        "pattern": "[<>\\r\\n]"
                    }
                }
            },
            "required": [
                "channel",
                "messageType",
                "text"
            ],
            "additionalProperties": false
        },
        "cue": {
            "description": "Підказка одного з двох різновидів зі спільними атрибутами",
            "oneOf": [
                {
                    "$ref": "#/$defs/textCue",
                    "description": "Текстова форма"
                },
                {
                    "$ref": "#/$defs/audioCue",
                    "description": "Звукова форма"
                }
            ]
        },
        "observation": {
            "type": "object",
            "description": "Спостереження поточного тренування. Відеокадр не зберігається",
            "properties": {
                "capturedAt": {
                    "type": "string",
                    "description": "Мітка часу спостереження з часовим поясом",
                    "format": "date-time",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?(Z|[+-][0-9]{2}:[0-9]{2})$"
                },
                "phaseNumber": {
                    "type": "integer",
                    "description": "Номер фази, з еталоном якої порівнюється рух",
                    "minimum": 1,
                    "maximum": 32
                },
                "isValid": {
                    "type": "boolean",
                    "description": "Чи визначено стан за маркером"
                },
                "state": {
                    "description": "Визначений стан або null за відсутності валідного стану",
                    "anyOf": [
                        {
                            "$ref": "#/$defs/spatialState",
                            "description": "Просторовий стан"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "deviations": {
                    "type": "array",
                    "description": "Відхилення; кожний вид зустрічається не більше одного разу",
                    "items": {
                        "$ref": "#/$defs/deviation",
                        "description": "Відхилення"
                    },
                    "minItems": 0,
                    "maxItems": 4,
                    "uniqueItems": true
                },
                "cues": {
                    "type": "array",
                    "description": "До однієї текстової та однієї звукової підказки",
                    "items": {
                        "$ref": "#/$defs/cue",
                        "description": "Підказка"
                    },
                    "minItems": 0,
                    "maxItems": 2,
                    "uniqueItems": true
                }
            },
            "required": [
                "capturedAt",
                "phaseNumber",
                "isValid",
                "state",
                "deviations",
                "cues"
            ],
            "additionalProperties": false,
            "if": {
                "properties": {
                    "isValid": {
                        "const": true
                    }
                }
            },
            "then": {
                "properties": {
                    "state": {
                        "type": "object"
                    }
                }
            },
            "else": {
                "properties": {
                    "state": {
                        "type": "null"
                    },
                    "deviations": {
                        "maxItems": 0
                    }
                }
            }
        },
        "training": {
            "type": "object",
            "description": "Оперативні дані активного тренування",
            "properties": {
                "exerciseId": {
                    "type": "string",
                    "description": "Посилання на обрану вправу",
                    "pattern": "^EX-[0-9]{3}$",
                    "minLength": 6,
                    "maxLength": 6
                },
                "startedAt": {
                    "type": "string",
                    "description": "Дата і час початку тренування",
                    "format": "date-time",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?(Z|[+-][0-9]{2}:[0-9]{2})$"
                },
                "soundEnabled": {
                    "type": "boolean",
                    "description": "Чи ввімкнений звуковий супровід"
                },
                "observations": {
                    "type": "array",
                    "description": "Спостереження за тренування до 60 хв при 10 спостереженнях/с",
                    "items": {
                        "$ref": "#/$defs/observation",
                        "description": "Спостереження"
                    },
                    "minItems": 0,
                    "maxItems": 36000
                }
            },
            "required": [
                "exerciseId",
                "startedAt",
                "soundEnabled",
                "observations"
            ],
            "additionalProperties": false
        },
        "result": {
            "type": "object",
            "description": "Підсумковий запис завершеного тренування в історії IndexedDB",
            "properties": {
                "resultId": {
                    "type": "string",
                    "description": "Ідентифікатор результату з глосарія ЛР2",
                    "minLength": 16,
                    "maxLength": 16,
                    "pattern": "^TR-[0-9]{8}-[0-9]{4}$"
                },
                "exerciseId": {
                    "type": "string",
                    "description": "Посилання на виконану вправу",
                    "pattern": "^EX-[0-9]{3}$",
                    "minLength": 6,
                    "maxLength": 6
                },
                "startedAt": {
                    "type": "string",
                    "description": "Дата і час початку завершеного тренування",
                    "format": "date-time",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?(Z|[+-][0-9]{2}:[0-9]{2})$"
                },
                "activeDurationSeconds": {
                    "type": "number",
                    "description": "Активний час без пауз і втрати відстеження, с",
                    "minimum": 0,
                    "maximum": 3600
                },
                "repetitionCount": {
                    "type": "integer",
                    "description": "Кількість завершених циклів",
                    "minimum": 0,
                    "maximum": 100
                },
                "validObservationCount": {
                    "type": "integer",
                    "description": "Кількість валідних спостережень",
                    "minimum": 0,
                    "maximum": 36000
                },
                "withinToleranceCount": {
                    "type": "integer",
                    "description": "Кількість валідних спостережень у допусках",
                    "minimum": 0,
                    "maximum": 36000
                },
                "accuracyPercent": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "description": "Оцінка техніки; null без валідних спостережень",
                    "minimum": 0,
                    "maximum": 100
                },
                "deviationTypes": {
                    "type": "array",
                    "description": "Види відхилень за тренування",
                    "items": {
                        "description": "Вид відхилення",
                        "enum": [
                            "position",
                            "tilt",
                            "yaw",
                            "roll"
                        ]
                    },
                    "minItems": 0,
                    "maxItems": 4,
                    "uniqueItems": true
                }
            },
            "required": [
                "resultId",
                "exerciseId",
                "startedAt",
                "activeDurationSeconds",
                "repetitionCount",
                "validObservationCount",
                "withinToleranceCount",
                "accuracyPercent",
                "deviationTypes"
            ],
            "additionalProperties": false,
            "if": {
                "properties": {
                    "validObservationCount": {
                        "const": 0
                    }
                }
            },
            "then": {
                "properties": {
                    "accuracyPercent": {
                        "type": "null"
                    },
                    "withinToleranceCount": {
                        "const": 0
                    }
                }
            },
            "else": {
                "properties": {
                    "accuracyPercent": {
                        "type": "integer"
                    }
                }
            }
        }
    },
    "examples": [
        {
            "catalog": {
                "exercises": [
                    {
                        "exerciseId": "EX-001",
                        "name": "Піднімання палиці перед собою",
                        "reference": {
                            "targetRepetitions": 10,
                            "phases": [
                                {
                                    "number": 1,
                                    "name": "Початкове положення",
                                    "referenceState": {
                                        "xCm": 0,
                                        "yCm": 0,
                                        "zCm": 0,
                                        "tiltDeg": 0,
                                        "yawDeg": 0,
                                        "rollDeg": 0
                                    },
                                    "positionToleranceCm": 5,
                                    "angleToleranceDeg": 10
                                },
                                {
                                    "number": 2,
                                    "name": "Піднімання",
                                    "referenceState": {
                                        "xCm": 0,
                                        "yCm": 40,
                                        "zCm": 0,
                                        "tiltDeg": 0,
                                        "yawDeg": 0,
                                        "rollDeg": 0
                                    },
                                    "positionToleranceCm": 5,
                                    "angleToleranceDeg": 10
                                },
                                {
                                    "number": 3,
                                    "name": "Повернення",
                                    "referenceState": {
                                        "xCm": 0,
                                        "yCm": 0,
                                        "zCm": 0,
                                        "tiltDeg": 0,
                                        "yawDeg": 0,
                                        "rollDeg": 0
                                    },
                                    "positionToleranceCm": 5,
                                    "angleToleranceDeg": 10
                                }
                            ]
                        }
                    }
                ]
            },
            "currentTraining": {
                "exerciseId": "EX-001",
                "startedAt": "2026-10-24T08:00:00+03:00",
                "soundEnabled": true,
                "observations": [
                    {
                        "capturedAt": "2026-10-24T08:00:00.100+03:00",
                        "phaseNumber": 2,
                        "isValid": true,
                        "state": {
                            "xCm": 0,
                            "yCm": 40,
                            "zCm": 0,
                            "tiltDeg": 18,
                            "yawDeg": 0,
                            "rollDeg": 0
                        },
                        "deviations": [
                            {
                                "type": "tilt",
                                "value": 18
                            }
                        ],
                        "cues": [
                            {
                                "channel": "text",
                                "messageType": "correction",
                                "text": "Вирівняй палицю горизонтально"
                            },
                            {
                                "channel": "audio",
                                "messageType": "correction",
                                "text": "Вирівняй палицю горизонтально"
                            }
                        ]
                    },
                    {
                        "capturedAt": "2026-10-24T08:00:00.200+03:00",
                        "phaseNumber": 2,
                        "isValid": true,
                        "state": {
                            "xCm": 0,
                            "yCm": 40,
                            "zCm": 0,
                            "tiltDeg": 0,
                            "yawDeg": 0,
                            "rollDeg": 0
                        },
                        "deviations": [],
                        "cues": [
                            {
                                "channel": "text",
                                "messageType": "correction_confirmed",
                                "text": "Відхилення усунуто"
                            }
                        ]
                    },
                    {
                        "capturedAt": "2026-10-24T08:00:00.800+03:00",
                        "phaseNumber": 2,
                        "isValid": false,
                        "state": null,
                        "deviations": [],
                        "cues": [
                            {
                                "channel": "text",
                                "messageType": "tracking_lost",
                                "text": "Маркер не видно. Поверни палицю в кадр"
                            }
                        ]
                    }
                ]
            },
            "results": [
                {
                    "resultId": "TR-20261023-0001",
                    "exerciseId": "EX-001",
                    "startedAt": "2026-10-23T17:00:00+03:00",
                    "activeDurationSeconds": 300,
                    "repetitionCount": 10,
                    "validObservationCount": 3000,
                    "withinToleranceCount": 2700,
                    "accuracyPercent": 90,
                    "deviationTypes": [
                        "tilt"
                    ]
                },
                {
                    "resultId": "TR-20261023-0002",
                    "exerciseId": "EX-001",
                    "startedAt": "2026-10-23T18:00:00+03:00",
                    "activeDurationSeconds": 0,
                    "repetitionCount": 0,
                    "validObservationCount": 0,
                    "withinToleranceCount": 0,
                    "accuracyPercent": null,
                    "deviationTypes": []
                }
            ]
        }
    ]
}
